{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false
  },
  "include": [
    "src/islands/legacy-globals.d.ts",
    "src/islands/HeaderStore.js",
    "src/islands/StudyStore.js",
    "src/islands/ExamState.js",
    "src/islands/SrsEngine.js",
    "src/islands/db.js",
    "src/islands/AppState.js",
    "src/islands/StorageEngine.js"
  ]
}
