rules_version = '2';
// Source of truth for the Firestore security rules of project hanzi-mind-dd34c.
// Publish: Firebase console → Firestore Database → Rules → paste this file → Publish.
// Sync layout: docs/auth-sync-plan.md §3. Leaderboard: docs/league-plan.md.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Progress sync: owner-only, strict shape and size ----------
    match /users/{uid}/snapshots/{namespace} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && namespace.matches('^[a-z_]+(:[a-z0-9_-]+){0,2}$')
        && request.resource.data.keys().hasOnly(['schemaVersion', 'deviceId', 'updatedAt', 'data'])
        && request.resource.data.schemaVersion is int
        && request.resource.data.deviceId is string && request.resource.data.deviceId.size() <= 64
        && request.resource.data.updatedAt == request.time
        && request.resource.data.data is string && request.resource.data.data.size() <= 900000;
    }

    // ---------- Weekly leaderboard: leagues/{weekNo}/entries/{uid} ----------
    // Limits mirror src/islands/LeagueConstants.js (300 XP per write, 20 s between writes,
    // 25000 XP per week). weekNo = floor((ms + 7 h + 3 d) / 7 d): weeks start Monday 00:00 UTC+7.
    match /leagues/{weekNo}/entries/{uid} {
      function signedIn() {
        return request.auth != null;
      }
      function isOwner() {
        return signedIn() && request.auth.uid == uid;
      }
      function isCurrentWeek() {
        return weekNo.matches('^[0-9]{1,6}$')
          && int(weekNo) == math.floor((request.time.toMillis() + 25200000 + 259200000) / 604800000);
      }
      function validEntry(d) {
        return d.keys().hasOnly(['uid', 'nickname', 'avatar', 'xp', 'updatedAt', 'schemaVersion'])
          && d.uid == uid
          && d.nickname is string && d.nickname.matches('^[\\p{L}\\p{N} _.-]{2,20}$')
          && d.avatar in ['crane', 'dragon', 'tiger', 'bear', 'bamboo', 'plum', 'pine', 'rabbit']
          && d.xp is int && d.xp >= 0 && d.xp <= 25000
          && d.updatedAt == request.time
          && d.schemaVersion == 1;
      }

      // Public to signed-in users: only nickname, seal avatar and weekly XP are stored here.
      allow get, list: if signedIn();
      allow create: if isOwner() && isCurrentWeek()
        && validEntry(request.resource.data)
        && request.resource.data.xp <= 300;
      allow update: if isOwner() && isCurrentWeek()
        && validEntry(request.resource.data)
        && request.resource.data.xp >= resource.data.xp
        && request.resource.data.xp - resource.data.xp <= 300
        && request.time > resource.data.updatedAt + duration.value(20, 's');
      // Leaving the board or deleting the account removes entries of any week.
      allow delete: if isOwner();
    }
  }
}
