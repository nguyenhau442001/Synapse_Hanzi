[{"id":3,"hanzi":"八","pinyin":"bā","hanviet":"Bát","meaning":"tám","example_zh":"我有<u>八</u>本书。","example_py":"Wǒ yǒu <u>bā</u> běn shū.","expected_pinyin":"wo3 you3 ba1 ben3 shu1","example_vi":"Tôi có <u>tám</u> cuốn sách."},{"id":510,"hanzi":"电话","pinyin":"diànhuà","hanviet":"Điện Thoại","meaning":"điện thoại","example_zh":"<u>电话</u>占线了","example_py":"<u>diànhuà</u> zhànxiàn le","expected_pinyin":"","example_vi":"Điện thoại đang bận."},{"id":80,"hanzi":"多","pinyin":"duō","hanviet":"Đa","meaning":"nhiều","example_zh":"这里有很<u>多</u>人。","example_py":"Zhèlǐ yǒu hěn<u>duō</u> rén.","expected_pinyin":"zhe4 li3 you3 hen3 duo1 ren2","example_vi":"Ở đây có rất <u>nhiều</u> người."},{"id":81,"hanzi":"多少","pinyin":"duōshao","hanviet":"Đa Thiểu","meaning":"bao nhiêu","example_zh":"这个<u>多少</u>钱？","example_py":"Zhège <u>duōshao</u> qián?","expected_pinyin":"zhe4 ge0 duo1 shao0 qian2","example_vi":"Cái này giá <u>bao nhiêu</u>?"},{"id":84,"hanzi":"二","pinyin":"èr","hanviet":"Nhị","meaning":"hai","example_zh":"我家有<u>二</u>个孩子。","example_py":"Wǒ jiā yǒu <u>èr</u> ge háizi.","expected_pinyin":"wo3 jia1 you3 er4 ge0 hai2 zi0","example_vi":"Nhà tôi có <u>hai</u> đứa trẻ."},{"id":134,"hanzi":"几","pinyin":"jǐ","hanviet":"Kỷ","meaning":"mấy, bao nhiêu","example_zh":"你有<u>几</u>个孩子？","example_py":"Nǐ yǒu <u>jǐ</u> ge háizi?","expected_pinyin":"ni3 you3 ji3 ge0 hai2 zi0","example_vi":"Bạn có <u>mấy</u> đứa con?"},{"id":529,"hanzi":"今年","pinyin":"jīnnián","hanviet":"Kim Niên","meaning":"năm nay","example_zh":"<u>今年</u>是好年","example_py":"<u>jīnnián</u> shì hǎo nián","expected_pinyin":"","example_vi":"Năm nay là một năm tốt."},{"id":148,"hanzi":"九","pinyin":"jiǔ","hanviet":"Cửu","meaning":"chín","example_zh":"我<u>九</u>点上班。","example_py":"Wǒ <u>jiǔ</u> diǎn shàngbān.","expected_pinyin":"wo3 jiu3 dian3 shang4 ban1","example_vi":"Tôi đi làm lúc <u>chín</u> giờ."},{"id":532,"hanzi":"块","pinyin":"kuài","hanviet":"Khối","meaning":"đồng (tiền), miếng","example_zh":"这个苹果三<u>块</u>钱。","example_py":"Zhège 