[{"id":10,"hanzi":"杯子","pinyin":"bēizi","hanviet":"Bôi Tử","meaning":"cái cốc","example_zh":"这是我的<u>杯子</u>。","example_py":"Zhè shì wǒ de <u>bēizi</u>.","expected_pinyin":"zhe4 shi4 wo3 de0 bei1 zi0","example_vi":"Đây là <u>cốc</u> của tôi."},{"id":506,"hanzi":"大学","pinyin":"dàxué","hanviet":"Đại Học","meaning":"đại học","example_zh":"他是<u>大学</u>的教授","example_py":"tā shì <u>dàxué</u> de jiàoshòu","expected_pinyin":"","example_vi":"Anh ấy là giáo sư đại học."},{"id":60,"hanzi":"的","pinyin":"de","hanviet":"Đích","meaning":"của (trợ từ)","example_zh":"这是我<u>的</u>书。","example_py":"Zhè shì wǒ <u>de</u> shū.","expected_pinyin":"zhe4 shi4 wo3 de0 shu1","example_vi":"Đây là sách <u>của</u> tôi."},{"id":76,"hanzi":"都","pinyin":"dōu","hanviet":"Đô","meaning":"đều","example_zh":"我们<u>都</u>喜欢中国菜。","example_py":"Wǒmen <u>dōu</u> xǐhuan zhōngguó cài.","expected_pinyin":"wo3 men0 dou1 xi3 huan0 zhong1 guo2 cai4","example_vi":"Chúng tôi <u>đều</u> thích món ăn Trung Quốc."},{"id":97,"hanzi":"个","pinyin":"gè","hanviet":"Cá","meaning":"cái (lượng từ)","example_zh":"我有一<u>个</u>朋友。","example_py":"Wǒ yǒu yī <u>ge</u> péngyou.","expected_pinyin":"wo3 you3 yi1 ge0 peng2 you0","example_vi":"Tôi có <u>một</u> người bạn."},{"id":113,"hanzi":"汉语","pinyin":"Hànyǔ","hanviet":"Hán Ngữ","meaning":"tiếng Hán, tiếng Trung","example_zh":"我在学习<u>汉语</u>。","example_py":"Wǒ zài xuéxí <u>hànyǔ</u>.","expected_pinyin":"wo3 zai4 xue2 xi2 han4 yu3","example_vi":"Tôi đang học <u>tiếng Trung</u>."},{"id":207,"hanzi":"那","pinyin":"nà","hanviet":"Na","meaning":"đó, kia","example_zh":"<u>那</u>是我的家。","example_py":"<u>Nà</u> shì wǒ de jiā.","expected_pinyin":"na4 shi4 wo3 de0 jia1","example_vi":"<u>Đó</u> là nhà của tôi."},{"id":546,"hanzi":"那个","pinyin":"nàge","hanviet":"Na Cá","meaning":"cái đó (đại từ)","example_zh":"我们坐船去<u>那个</u>岛","example_py":"wǒmen zuòchuánqù <u>nàge</u> dǎo","expected_pinyin":"","example_vi":"Chúng tôi đi thuyền đến đảo đó."},{"id":222,"hanzi":"朋友","pinyin":"péngyou","hanviet":"Bằng Hữu","