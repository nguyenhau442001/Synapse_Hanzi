[{"id":4,"hanzi":"爸爸","pinyin":"bàba","hanviet":"Ba Ba","meaning":"ba, bố","example_zh":"<u>爸爸</u>在工作。","example_py":"<u>Bàba</u> zài gōngzuò.","expected_pinyin":"ba4 ba0 zai4 gong1 zuo4","example_vi":"<u>Bố</u> đang làm việc."},{"id":79,"hanzi":"对","pinyin":"duì","hanviet":"Đối","meaning":"đối với, hướng về (giới từ)","example_zh":"他<u>对</u>中国文化很感兴趣。","example_py":"Tā <u>duì</u> zhōngguó wénhuà hěn gǎn xìngqù.","expected_pinyin":"ta1 dui4 zhong1 guo2 wen2 hua4 hen3 gan3 xing4 qu4","example_vi":"Anh ấy <u>đối với</u> văn hóa Trung Quốc rất có hứng thú."},{"id":96,"hanzi":"哥哥","pinyin":"gēge","hanviet":"Ca Ca","meaning":"anh trai","example_zh":"我<u>哥哥</u>在北京工作。","example_py":"Wǒ <u>gēge</u> zài běijīng gōngzuò.","expected_pinyin":"wo3 ge1 ge0 zai4 bei3 jing1 gong1 zuo4","example_vi":"<u>Anh trai</u> tôi làm việc ở Bắc Kinh."},{"id":103,"hanzi":"工作","pinyin":"gōngzuò","hanviet":"Công Tác","meaning":"công việc, làm việc","example_zh":"他在医院<u>工作</u>。","example_py":"Tā zài yīyuàn <u>gōngzuò</u>.","expected_pinyin":"ta1 zai4 yi1 yuan4 gong1 zuo4","example_vi":"Anh ấy <u>làm việc</u> ở bệnh viện."},{"id":135,"hanzi":"家","pinyin":"jiā","hanviet":"Gia","meaning":"nhà","example_zh":"我<u>家</u>有四个人。","example_py":"Wǒ <u>jiā</u> yǒu sì ge rén.","expected_pinyin":"wo3 jia1 you3 si4 ge0 ren2","example_vi":"<u>Nhà</u> tôi có bốn người."},{"id":142,"hanzi":"姐姐","pinyin":"jiějie","hanviet":"Tỷ Tỷ","meaning":"chị gái","example_zh":"我<u>姐姐</u>是老师。","example_py":"Wǒ <u>jiějie</u> shì lǎoshī.","expected_pinyin":"wo3 jie3 jie0 shi4 lao3 shi1","example_vi":"<u>Chị</u> tôi là giáo viên."},{"id":164,"hanzi":"口","pinyin":"kǒu","hanviet":"Khẩu","meaning":"miệng; cái (lượng từ)","example_zh":"这个瓶子的<u>口</u>很小。","example_py":"Zhège píngzi de <u>kǒu</u> hěn xiǎo.","expected_pinyin":"zhe4 ge0 ping2 zi0 de0 kou3 hen3 xiao3","example_vi":"<u>Miệng</u> của cái lọ này rất nhỏ."},{"id":187,"hanzi":"妈妈","pinyin":"māma","hanviet":"Ma Ma","meaning":"mẹ","example_zh":"<u>妈妈</u>在做饭。","example_py":"<u>Māma</u