[{"id":301,"hanzi":"啊","pinyin":"a","hanviet":"A","meaning":"à (trợ từ ngữ khí)","example_zh":"<u>啊</u>，你来了！","example_py":"<u>A</u>, nǐ lái le!","expected_pinyin":"a0 | ni3 lai2 le0","example_vi":"<u>À</u>, bạn đến rồi!"},{"id":314,"hanzi":"长","pinyin":"cháng","hanviet":"Trường","meaning":"dài","example_zh":"她的头发很<u>长</u>。","example_py":"Tā de tóufa hěn <u>cháng</u>.","expected_pinyin":"ta1 de0 tou2 fa0 hen3 chang2","example_vi":"Tóc của cô ấy rất <u>dài</u>."},{"id":323,"hanzi":"次","pinyin":"cì","hanviet":"Thứ","meaning":"lần","example_zh":"我去过中国两<u>次</u>。","example_py":"Wǒ qù guò zhōngguó liǎng <u>cì</u>.","expected_pinyin":"wo3 qu4 guo4 zhong1 guo2 liang3 ci4","example_vi":"Tôi đã đến Trung Quốc hai <u>lần</u>."},{"id":324,"hanzi":"从","pinyin":"cóng","hanviet":"Tòng","meaning":"từ","example_zh":"他<u>从</u>北京来。","example_py":"Tā <u>cóng</u> běijīng lái.","expected_pinyin":"ta1 cong2 bei3 jing1 lai2","example_vi":"Anh ấy đến <u>từ</u> Bắc Kinh."},{"id":347,"hanzi":"过","pinyin":"guò","hanviet":"Quá","meaning":"vượt qua","example_zh":"<u>过</u>马路要小心","example_py":"<u>guò</u> mǎlù yào xiǎoxīn","expected_pinyin":"","example_vi":"Qua đường phải cẩn thận."},{"id":351,"hanzi":"过","pinyin":"guo","hanviet":"Quá","meaning":"đã từng (trợ từ)","example_zh":"我去<u>过</u>中国。","example_py":"Wǒ qù <u>guò</u> zhōngguó.","expected_pinyin":"wo3 qu4 guo4 zhong1 guo2","example_vi":"Tôi <u>đã từng</u> đến Trung Quốc."},{"id":366,"hanzi":"间","pinyin":"jiān","hanviet":"Gian","meaning":"gian, phòng (lượng từ); giữa","example_zh":"学校图书馆里有几<u>间</u>安静的自习室。","example_py":"Xuéxiào túshūguǎn lǐ yǒu jǐ <u>jiān</u> ānjìng de zìxí shì.","expected_pinyin":"xue2 xiao4 tu2 shu1 guan3 li3 you3 ji3 jian1 an1 jing4 de0 zi4 xi2 shi4","example_vi":"Trong thư viện trường học có vài <u>gian</u> phòng tự học yên tĩnh."},{"id":376,"hanzi":"就","pinyin":"jiù","hanviet":"Tựu","meaning":"là, ngay (trợ từ nhấn mạnh)","example_zh":"我马上<u>就</u>来。","example_py":"Wǒ mǎshàng <u>jiù</u> lái.","expected_pinyin":"wo3 ma3 shan