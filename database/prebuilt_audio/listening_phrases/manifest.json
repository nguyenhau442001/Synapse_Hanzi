{
  "version": 1,
  "voice": "zh-CN-XiaoxiaoNeural",
  "items": {
    "lp_11a02b93f552": {
      "text": "阳光多好啊",
      "tts_text": "阳光多好啊。",
      "url": "database/prebuilt_audio/listening_phrases/lp_11a02b93f552.mp3?v=e0f98492119e"
    },
    "lp_95742359600c": {
      "text": "从来没有……过",
      "tts_text": "但是我们从来没有说过话。",
      "url": "database/prebuilt_audio/listening_phrases/lp_95742359600c.mp3?v=c467a41ad521"
    },
    "lp_bd62ac16a182": {
      "text": "一点儿也不……",
      "tts_text": "一点儿也不复杂。",
      "url": "database/prebuilt_audio/listening_phrases/lp_bd62ac16a182.mp3?v=7b3c193ee031"
    },
    "lp_6eb4cd276d6a": {
      "text": "矮个子",
      "tts_text": "矮个子。",
      "url": "database/prebuilt_audio/listening_phrases/lp_6eb4cd276d6a.mp3?v=b3c2583aa5c5"
    },
    "lp_3a32f3a4c552": {
      "text": "不只是……也是……",
      "tts_text": "篮球不只是让那些高个子打的，也是给那些喜欢它的人们打的。",
      "url": "database/prebuilt_audio/listening_phrases/lp_3a32f3a4c552.mp3?v=c16b9e630b79"
    },
    "lp_87f2fbe1ca5a": {
      "text": "鼓掌祝贺",
      "tts_text": "鼓掌祝贺。",
      "url": "database/prebuilt_audio/listening_phrases/lp_87f2fbe1ca5a.mp3?v=9ffb726a4b25"
    },
    "lp_1c2aeae59c68": {
      "text": "马上就要……了",
      "tts_text": "飞机马上就要起飞了。",
      "url": "database/prebuilt_audio/listening_phrases/lp_1c2aeae59c68.mp3?v=d24fa3c4798c"
    },
    "lp_5a41a0613537": {
      "text": "正好相反",
      "tts_text": "正好相反。",
      "url": "database/prebuilt_audio/listening_phrases/lp_5a41a0613537.mp3?v=9166715c909a"
    },
    "lp_ba4cc67b15e9": {
      "text": "计划书",
      "tts_text": "计划书。",
      "url": "database/prebuilt_audio/listening_phrases/lp_ba4cc67b15e9.mp3?v=5c5004035183"
    },
    "lp_6bcc8a73f8d1": {
      "text": "尽管……不过……",
      "tts_text": "三岁的女儿尽管很害怕打针，不过她没有哭。",
      "url": "database/prebuilt_audio/listening_phrases/lp_6bcc8a73f8d1.mp3?v=b1907e3f92b5"
    }
  }
}
