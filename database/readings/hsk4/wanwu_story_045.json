    {
      "id": "s5",
      "zh": "近代以来，绿色邮筒与邮政网络的普及，让信息传递更加安全便捷地飞向千家万户。",
      "pinyin": "Jìndài yǐlái, lǜsè yóutǒng yǔ yóuzhèng wǎnglù de pǔjí, ràng xìnxī chuándì gèngjiā ānquán biànjié de fēixiàng qiānjiā-wànhù.",
      "vi": "Thời cận đại, hòm thư màu xanh và mạng lưới bưu điện phổ cập đã giúp việc gửi trao thông tin đến với muôn nhà an toàn, tiện lợi hơn.",
      "audio_start_ms": null,
      "audio_end_ms": null,
      "tokens": [
        {
          "text": "近代",
          "pinyin": "jìndài",
          "hanviet": "Cận Đại",
          "hsk": 5,
          "word_id": "hsk5_614",
          "meaning_vi": "thời cận đại"
        },
