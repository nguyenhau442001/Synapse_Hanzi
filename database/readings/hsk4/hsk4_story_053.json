  "quiz": [
    {
      "id": "q1",
      "question_vi": "Theo truyền thuyết, danh y nào đã phát minh ra món tiền thân của sủi cảo mang tên 'Kiều nhĩ'?",
      "options_vi": [
        "Trương Trọng Cảnh (张仲景)",
        "Hoa Đà (华佗)",
        "Lý Thời Trân (李时珍)"
      ],
      "answer": 0,
      "explanation_vi": "Trương Trọng Cảnh đã chế ra 'Canh Kiều nhĩ trừ hàn' để chữa rét buốt tai cho bá tánh."
    },
    {
      "id": "q2",
      "question_vi": "Ban đầu Trương Trọng Cảnh làm món 'Kiều nhĩ' này nhằm mục đích gì?",
      "options_vi": [
        "Để chữa chứng cóng tai trong mùa đông lạnh giá",
        "Để bán kiếm tiền",
        "Để dâng lên hoàng đế"
      ],
      "answer": 0,
      "explanation_vi": "Mục đích ban đầu là một phương thuốc trừ hàn trị lạnh cóng tai cho người nghèo."
    },
