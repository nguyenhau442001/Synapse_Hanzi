  "quiz": [
    {
      "id": "q1",
      "question_vi": "Nhân vật lịch sử nổi tiếng nào gắn liền với giai thoại 'Chiêu Quân xuất tái' (昭君出塞)?",
      "options_vi": [
        "Vương Chiêu Quân (王昭君)",
        "Tây Thi",
        "Điêu Thuyền"
      ],
      "answer": 0,
      "explanation_vi": "Vương Chiêu Quân tình nguyện đi hòa thân với Thiền vu Hung Nô để giữ yên bờ cõi."
    },
    {
      "id": "q2",
      "question_vi": "Ý nghĩa lịch sử quan trọng nhất của chuyến xuất tái của Vương Chiêu Quân là gì?",
      "options_vi": [
        "Mang lại hòa bình và giao lưu văn hóa, buôn bán suốt hơn nửa thế kỷ ở vùng biên giới",
        "Gây ra chiến tranh lớn",
        "Làm mất hết ngựa chiến"
      ],
      "answer": 0,
      "explanation_vi": "Cuộc hòa thân mang lại nửa thế kỷ bình yên không tiếng đao kiếm giữa hai dân tộc."
    },
    {
      "id": "q3",
      "question_vi": "Nhạc cụ nào thường gắn liền với hình ảnh công chúa đi hòa thân trong thi ca hội họa?",
      "options_vi": [
