  "quiz": [
    {
      "id": "q1",
      "question_vi": "Theo truyền thuyết lịch sử, ai là người phát minh ra món đậu phụ?",
      "options_vi": [
        "Hoài Nam Vương Lưu An (刘安)",
        "Gia Cát Lượng (诸葛亮)",
        "Tần Thủy Hoàng (秦始皇)"
      ],
      "answer": 0,
      "explanation_vi": "Hoài Nam Vương Lưu An thời Tây Hán trong lúc luyện đan đã vô tình làm đậu nành đông kết thành đậu phụ."
    },
    {
      "id": "q2",
      "question_vi": "Đậu phụ được tình cờ tạo ra trong quá trình làm việc gì?",
      "options_vi": [
        "Trong quá trình luyện đan",
        "Trong lúc nấu cháo",
        "Trong lúc làm rượu"
      ],
      "answer": 0,
      "explanation_vi": "Trong lúc luyện đan, chất làm đông (thạch cao/muối khoáng) rơi vào nước đậu nành."
    },
    {
      "id": "q3",
      "question_vi": "Đậu phụ được coi là cống hiến lớn vì lý do gì?",
      "options_vi": [
        "Hương vị thơm ngon, dinh dưỡng phong phú và là biểu tượng ẩm thực thanh đạm",
        "Vì có thể bảo quản trăm năm",
        "Vì dùng để chế tạo đồ gia dụng"
      ],
      "answer": 0,
      "explanation_vi": "Đậu phụ cung cấp nguồn đạm thực vật quý báu cho ẩm thực Đông phương và thế giới."
    }
  ]
