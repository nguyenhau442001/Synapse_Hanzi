  "quiz": [
    {
      "id": "q1",
      "question_vi": "Theo nhà vật lý Lý Chính Đạo, đôi đũa đã ứng dụng nguyên lý vật lý nào?",
      "options_vi": [
        "Nguyên lý đòn bẩy",
        "Nguyên lý lực ma sát",
        "Nguyên lý trọng lực"
      ],
      "answer": 0,
      "explanation_vi": "Trong bài có viết: 巧妙地应用了杠杆原理 (Khéo léo ứng dụng nguyên lý đòn bẩy)."
    },
    {
      "id": "q2",
      "question_vi": "Vào thời cổ đại, chiếc đũa được gọi là gì?",
      "options_vi": [
        "Thìa (勺子)",
        "Trợ (箸)",
        "Đao (刀)"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có viết: 在古代，筷子并不叫“筷子”，而是被称为“箸” (Thời cổ đại, đũa được gọi là Trợ)."
    },
    {
      "id": "q3",
      "question_vi": "Tại sao thủy thủ Giang Nam thời nhà Minh lại đổi gọi từ Trợ sang Khoái?",
      "options_vi": [
        "Vì đũa làm bằng tre mau hỏng",
        "Vì chữ Trợ đồng âm với chữ Trú (dừng tàu, đứng yên), nên họ muốn cầu chúc đi nhanh",
        "Do triều đình bắt buộc đổi tên"
      ],
      "answer": 1,
      "explanation_vi": "Thủy thủ kiêng thuyền dừng lại (住), mà Trợ (箸) đọc giống Trú (住), nên đổi thành Khoái (快 - mau lẹ)."
    }
  ]
